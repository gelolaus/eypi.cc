# Copy this file to backend/.dev.vars and fill in your values.
# Used by: wrangler dev, npm run backfill-kv, node run-migration.mjs
#
# Turso dashboard → your database → Connect:
#   TURSO_DATABASE_URL = the libsql://... URL shown there
#   TURSO_AUTH_TOKEN   = a database token (same one you set on Cloudflare Workers)

# Do not wrap values in quotes — wrangler and local scripts expect plain values.

TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-database-token
JWT_SECRET=your-jwt-secret
RESEND_API_KEY=your-resend-api-key

# Apple Wallet — Pass Type ID certificate + WWDR intermediate (PEM, single line or multiline)
APPLE_PASS_TYPE_ID=pass.cc.eypi.event
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_PASS_CERT_PEM=
APPLE_PASS_KEY_PEM=
APPLE_WWDR_CERT_PEM=

# Google Wallet — service account with Wallet Object Issuer role
GOOGLE_WALLET_ISSUER_ID=1234567890123456789
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=wallet@your-project.iam.gserviceaccount.com
GOOGLE_WALLET_SERVICE_ACCOUNT_PRIVATE_KEY=
