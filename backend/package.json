{
  "name": "backend",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc --port 8787 --ip 127.0.0.1",
    "predeploy": "node ../scripts/release-check.mjs",
    "deploy": "wrangler deploy --minify --config wrangler.jsonc",
    "backfill-kv": "node scripts/backfill-links-kv.mjs",
    "migrate": "node scripts/migrate.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "bcryptjs": "^3.0.3",
    "fflate": "^0.8.3",
    "hono": "^4.13.14",
    "jose": "^6.2.3",
    "node-forge": "^1.4.0",
    "resend": "^6.9.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node-forge": "^1.3.14",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
