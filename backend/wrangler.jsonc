{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-01",
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "5859d48ee495460aad9d806e0e3c1523"
    },
    {
      "binding": "LINKS_KV",
      "id": "4634074c1831474fbb18209665da5165"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "eypi-media"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 19 * * *"]
  },
