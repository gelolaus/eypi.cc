{
    "name": "eypi-cc",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:api": "npm run dev --prefix backend",
        "dev:local": "node scripts/dev-local.mjs",
        "setup": "node scripts/setup.mjs",
        "doctor": "node scripts/doctor.mjs",
        "build": "vue-tsc -b && vite build",
        "preview": "npm run build && wrangler dev",
        "deploy": "vue-tsc -b && vite build && wrangler deploy --config dist/eypicc_frontend/wrangler.json",
        "predeploy": "node scripts/release-check.mjs",
        "release:check": "node scripts/release-check.mjs",
        "smoke": "node scripts/smoke.mjs",
        "lint": "eslint .",
        "typecheck": "vue-tsc -b && tsc --noEmit -p backend/tsconfig.json",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@libsql/client": "^0.17.0",
        "@tailwindcss/vite": "^4.3.3",
        "chart.js": "^4.5.1",
        "docxtemplater": "^3.68.3",
        "dompurify": "^3.4.17",
        "exceljs": "^4.4.0",
        "file-saver": "^2.0.5",
        "jszip": "^3.10.1",
        "marked": "^15.0.12",
        "papaparse": "^5.7.0",
        "pizzip": "^3.2.0",
        "qr-code-styling": "^1.9.2",
        "qr-scanner": "^1.4.2",
        "tw-animate-css": "^1.4.0",
        "vue": "^3.5.44",
        "vue-chartjs": "^5.3.3",
        "vue-router": "^4.6.4"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.65.0",
        "@cloudflare/workers-types": "^5.20261025.1",
        "@types/dompurify": "^3.2.0",
        "@types/file-saver": "^2.0.7",
        "@types/papaparse": "^5.5.2",
        "@vitejs/plugin-vue": "^5.2.1",
        "@vue/test-utils": "^2.5.1",
        "eslint": "^9.39.5",
        "eslint-plugin-vue": "^10.11.1",
        "eslint-plugin-vuejs-accessibility": "^2.6.3",
        "happy-dom": "^21.0.4",
        "tailwindcss": "^4.3.3",
        "typescript": "~5.6.2",
        "typescript-eslint": "^8.72.0",
        "vite": "^6.0.1",
        "vitest": "^4.1.10",
        "vue-tsc": "^2.1.10",
        "wrangler": "^4.152.0"
    },
    "allowScripts": {
        "esbuild@0.25.12": true,
        "esbuild@0.28.2": true,
        "workerd@1.20261019.1": true
    }
}
