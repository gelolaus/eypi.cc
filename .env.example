# Copy to .env.local (gitignored) for local full-stack development.
#
# Security: .env.local is never committed. Production builds ignore this file
# and default to https://api.eypi.cc when VITE_API_BASE_URL is unset.

# Local wrangler API (run: cd backend && npm run dev)
VITE_API_BASE_URL=http://localhost:8787
